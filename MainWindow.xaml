<Window x:Class="AetherisLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aetheris Launcher" Height="700" Width="1050"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0F1015"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI, Inter, Arial"
        AllowDrop="True"
        Drop="Window_Drop">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDark" Color="#0F1015" />
        <SolidColorBrush x:Key="BgCard" Color="#181A22" />
        <SolidColorBrush x:Key="BgCardHover" Color="#222532" />
        <SolidColorBrush x:Key="BorderColor" Color="#2A2E3D" />
        <SolidColorBrush x:Key="AccentCyan" Color="#00D2FF" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="TextDim" Color="#8C93A8" />
        <SolidColorBrush x:Key="TextLight" Color="#F3F4F6" />

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#222634" />
            <Setter Property="Foreground" Value="#ECEFF4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#2F3547" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2C3245" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#00D2FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1E2B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#00D2FF" />
            <Setter Property="Foreground" Value="#050C16" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38E1FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#10B981" />
            <Setter Property="Foreground" Value="#032014" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#34D399" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="70" />
            <!-- Content -->
            <RowDefinition Height="*" />
            <!-- Footer Progress -->
            <RowDefinition Height="65" />
        </Grid.RowDefinitions>

        <!-- HEADER BAR -->
        <Border Grid.Row="0" Background="#14161F" BorderBrush="#202433" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#00D2FF" />
                    <StackPanel>
                        <TextBlock Text="AETHERIS LAUNCHER" FontSize="18" FontWeight="ExtraBold" Foreground="#FFFFFF"  />
                        <TextBlock Text="NEXT-GEN MINECRAFT CORE" FontSize="10" FontWeight="SemiBold" Foreground="#00D2FF"  />
                    </StackPanel>
                </StackPanel>

                <!-- Top Center Quick Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="📦 Импорт с CurseForge (.zip)" Style="{StaticResource PrimaryButton}" Click="BtnImportCurseForge_Click" Margin="0,0,12,0" />
                    <Button Content="➕ Новый инстанс" Style="{StaticResource ModernButton}" Click="BtnNewInstance_Click" Margin="0,0,12,0" />
                    <Button Content="📜 Консоль логов" Style="{StaticResource ModernButton}" Click="BtnToggleConsole_Click" />
                </StackPanel>

                <!-- User Profile & Settings -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1C202C" CornerRadius="8" Padding="12,6" Margin="0,0,12,0" Cursor="Hand" MouseDown="AccountBorder_MouseDown">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <StackPanel>
                                <TextBlock x:Name="TxtAccountName" Text="Player" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13" />
                                <TextBlock x:Name="TxtAccountType" Text="Offline Mode" Foreground="#8C93A8" FontSize="10" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Content="⚙️" FontSize="16" Width="40" Height="40" Padding="0" Style="{StaticResource ModernButton}" Click="BtnSettings_Click" ToolTip="Настройки сети, Java и памяти" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ColConsole" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Instances Grid / List -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="Установленные сборки и инстансы" FontSize="18" FontWeight="Bold" Foreground="#F3F4F6" />
                    <TextBlock x:Name="TxtInstanceCount" Text="(0)" FontSize="14" Foreground="#8C93A8" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <!-- Scrollable Instances -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="InstancesContainer">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#181A24" BorderBrush="#252A3A" BorderThickness="1" CornerRadius="12" Margin="0,0,0,12" Padding="18">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon -->
                                        <Border Grid.Column="0" Width="60" Height="60" Background="#232737" CornerRadius="10" Margin="0,0,18,0">
                                            <TextBlock Text="🎮" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border Background="#202636" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding MinecraftVersion, StringFormat='MC {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="#00D2FF" />
                                                </Border>
                                                <Border Background="#282236" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding ModLoader}" FontSize="11" FontWeight="SemiBold" Foreground="#C084FC" />
                                                </Border>
                                                <Border Background="#1C2E29" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding AllocatedMemoryMb, StringFormat='RAM: {0} MB'}" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="▶️ ИГРАТЬ" Style="{StaticResource PlayButton}" Margin="0,0,8,0" Tag="{Binding}" Click="BtnPlayInstance_Click" />
                                            <Button Content="📁 Папка" Style="{StaticResource ModernButton}" Margin="0,0,8,0" Tag="{Binding}" Click="BtnOpenFolder_Click" ToolTip="Открыть папку инстанса" />
                                            <Button Content="🗑️" Style="{StaticResource ModernButton}" Tag="{Binding}" Click="BtnDeleteInstance_Click" ToolTip="Удалить сборку" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State Prompt -->
                <Border x:Name="BorderEmptyState" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📦" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <TextBlock Text="Сборок пока нет" FontSize="20" FontWeight="Bold" Foreground="#ECEFF4" HorizontalAlignment="Center" />
                        <TextBlock Text="Перетащите сюда .zip архив сборки с CurseForge или нажмите кнопку импорта" FontSize="13" Foreground="#8C93A8" HorizontalAlignment="Center" Margin="0,8,0,20" />
                        <Button Content="Импортировать сборку CurseForge (.zip)" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Click="BtnImportCurseForge_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Console Drawer -->
            <Border x:Name="ConsoleBorder" Grid.Column="1" Background="#0C0D12" BorderBrush="#252A3A" BorderThickness="1,0,0,0" Margin="16,0,0,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Консоль логов игры" FontWeight="Bold" Foreground="#ECEFF4" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCopyConsole" Content="📋 Скопировать" Style="{StaticResource ModernButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" Click="BtnCopyConsole_Click" />
                            <Button Content="Очистить" Style="{StaticResource ModernButton}" Padding="8,4" FontSize="11" Click="BtnClearConsole_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBox x:Name="TxtConsole" Grid.Row="1" Background="#07080A" Foreground="#38E1FF" FontFamily="Consolas, Courier New" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="8">
                        <TextBox.ContextMenu>
                            <ContextMenu Background="#14161F" Foreground="#ECEFF4">
                                <MenuItem Header="Копировать выделенное" Command="ApplicationCommands.Copy" />
                                <MenuItem Header="Скопировать всё" Click="BtnCopyConsole_Click" />
                                <Separator Background="#252A3A" />
                                <MenuItem Header="Очистить консоль" Click="BtnClearConsole_Click" />
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER PROGRESS & STATUS -->
        <Border Grid.Row="2" Background="#14161F" BorderBrush="#202433" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock x:Name="TxtStatus" Text="Готов к работе. Перетащите сборку CurseForge (.zip) для установки." FontSize="13" FontWeight="SemiBold" Foreground="#ECEFF4" />
                    <TextBlock x:Name="TxtProgressPercentage" Text="" FontSize="13" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar x:Name="ProgressBarMain" Grid.Row="1" Height="8" Background="#1C202C" Foreground="#00D2FF" BorderThickness="0" Value="0" Maximum="100" />
            </Grid>
        </Border>
    </Grid>
</Window>

