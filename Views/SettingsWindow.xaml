<Window x:Class="AetherisLauncher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Aetheris Launcher" Height="580" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#12131A" Foreground="#ECEFF4"
        FontFamily="Segoe UI, Inter, Arial"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="⚙️ Настройки лаунчера" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,20" />

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Game Root Directory -->
                <TextBlock Text="Папка установки игры и сборок" FontWeight="Bold" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtGameRoot" Height="36" Background="#1B1E29" Foreground="#FFFFFF" Padding="8,6" FontSize="13" VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="📁 Обзор..." Height="36" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" Click="BtnBrowseGameRoot_Click" />
                </Grid>

                <!-- RAM Allocation -->
                <TextBlock Text="Оперативная память (RAM) по умолчанию" FontWeight="Bold" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SliderMemory" Minimum="2048" Maximum="16384" SmallChange="512" LargeChange="1024" Value="4096" TickFrequency="1024" IsSnapToTickEnabled="False" VerticalAlignment="Center" ValueChanged="SliderMemory_ValueChanged" />
                    <TextBlock x:Name="TxtMemoryValue" Grid.Column="1" Text="4096 MB" FontWeight="Bold" Foreground="#00D2FF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <!-- Java Selection -->
                <TextBlock Text="Установка Java" FontWeight="Bold" Margin="0,0,0,6" />
                <ComboBox x:Name="CmbJava" Height="36" Background="#1D212E" Foreground="#12131A" Padding="8,4" Margin="0,0,0,16" />

                <!-- Discord Rich Presence -->
                <TextBlock Text="Интеграция с Discord" FontWeight="Bold" Margin="0,0,0,6" />
                <Border Background="#181B26" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox x:Name="ChkDiscordRpc" Content="Отображать активность в Discord (Rich Presence)" Foreground="#5865F2" FontWeight="SemiBold" IsChecked="True" />
                        <TextBlock Text="Показывает статус 'Играет в Aetheris', выбранную сборку, версию Minecraft и таймер игры." FontSize="11" Foreground="#8C93A8" Margin="20,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Network and Proxy -->
                <TextBlock Text="Сетевое соединение и прокси (обход блокировок)" FontWeight="Bold" Margin="0,0,0,6" />
                <Border Background="#181B26" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <RadioButton x:Name="RbSystemProxy" Content="Использовать системный прокси (подхватывает Happ / VPN)" Foreground="#ECEFF4" Margin="0,0,0,8" IsChecked="True" />
                        <RadioButton x:Name="RbDirect" Content="Прямое соединение без прокси" Foreground="#ECEFF4" Margin="0,0,0,8" />
                        <RadioButton x:Name="RbCustomProxy" Content="Свой прокси (например, 127.0.0.1:порт)" Foreground="#ECEFF4" Margin="0,0,0,8" Checked="RbCustomProxy_Checked" Unchecked="RbCustomProxy_Unchecked" />

                        <StackPanel x:Name="PanelCustomProxy" Orientation="Horizontal" Margin="20,4,0,0" Visibility="Collapsed">
                            <TextBlock Text="Хост:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#8C93A8" />
                            <TextBox x:Name="TxtProxyHost" Text="127.0.0.1" Width="120" Height="28" Background="#12141C" Foreground="#FFFFFF" Padding="6,2" Margin="0,0,12,0" />
                            <TextBlock Text="Порт:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#8C93A8" />
                            <TextBox x:Name="TxtProxyPort" Text="7890" Width="70" Height="28" Background="#12141C" Foreground="#FFFFFF" Padding="6,2" />
                        </StackPanel>

                        <Separator Background="#262B3D" Margin="0,12,0,12" />

                        <CheckBox x:Name="ChkUseMirror" Content="⚡ Использовать скоростное зеркало BMCLAPI (рекомендуется)" Foreground="#00D2FF" FontWeight="SemiBold" IsChecked="True" />
                        <TextBlock Text="Ускоряет загрузку версий Mojang, Fabric и модов CurseForge в десятки раз." FontSize="11" Foreground="#8C93A8" Margin="20,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Save Button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Width="100" Height="36" Margin="0,0,10,0" Background="#222634" Foreground="#ECEFF4" Click="BtnCancel_Click" />
            <Button Content="Сохранить" Width="120" Height="36" Background="#00D2FF" Foreground="#0A101D" FontWeight="Bold" Click="BtnSave_Click" />
        </StackPanel>
    </Grid>
</Window>
