<Window x:Class="AetherisLauncher.Views.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление аккаунтом" Height="460" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#12131A" Foreground="#ECEFF4"
        FontFamily="Segoe UI, Inter, Arial"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="👤 Выбор аккаунта" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16" />

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: Offline / Quick -->
            <TabItem Header="Офлайн режим" Background="#1D212E" Foreground="#12131A">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="Быстрый вход без пароля (для одиночной игры или серверов без проверки лицензии)" TextWrapping="Wrap" Foreground="#8C93A8" Margin="0,0,0,16" />
                    <TextBlock Text="Имя игрока (Никнейм):" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox x:Name="TxtOfflineUsername" Text="Player" Height="36" Background="#1B1E29" Foreground="#FFFFFF" Padding="8,6" FontSize="14" Margin="0,0,0,20" />
                    <Button Content="Применить этот никнейм" Height="38" Background="#10B981" Foreground="#032014" FontWeight="Bold" Click="BtnApplyOffline_Click" />
                </StackPanel>
            </TabItem>

            <!-- TAB 2: Microsoft License -->
            <TabItem Header="Лицензия Microsoft" Background="#1D212E" Foreground="#12131A">
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="Официальная авторизация Microsoft (OAuth 2.0 Device Flow)" FontWeight="Bold" Foreground="#ECEFF4" Margin="0,0,0,8" />
                    <TextBlock Text="Лаунчер не имеет доступа к вашему паролю. Вы подтверждаете вход прямо на официальном сайте Microsoft." TextWrapping="Wrap" Foreground="#8C93A8" Margin="0,0,0,16" />

                    <!-- Saved Account State -->
                    <StackPanel x:Name="PanelSavedAccount" Visibility="Collapsed" Margin="0,0,0,14">
                        <Border Background="#1A202C" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Сохраненный аккаунт Microsoft:" Foreground="#94A3B8" FontSize="12" />
                                <TextBlock x:Name="TxtSavedUsername" Text="_NAIPIX_" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,4,0,12" />
                                <Button x:Name="BtnUseSavedAccount" Content="✅ Выбрать этот аккаунт" Height="38" Background="#10B981" Foreground="#032014" FontWeight="Bold" Click="BtnUseSavedAccount_Click" Margin="0,0,0,8" />
                                <Button Content="🔄 Сменить аккаунт Microsoft" Height="30" Background="#334155" Foreground="#E2E8F0" FontSize="12" Click="BtnRelogin_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Initial State -->
                    <StackPanel x:Name="PanelStartLogin">
                        <Button Content="Войти через Microsoft" Height="40" Background="#00D2FF" Foreground="#0A101D" FontWeight="Bold" Click="BtnStartMicrosoftLogin_Click" />
                    </StackPanel>

                    <!-- Device Code State -->
                    <StackPanel x:Name="PanelDeviceCode" Visibility="Collapsed">
                        <TextBlock Text="Код для входа:" Foreground="#8C93A8" HorizontalAlignment="Center" />
                        <Border Background="#1A1E2B" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="8" Padding="16,8" HorizontalAlignment="Center" Margin="0,8,0,12">
                            <TextBlock x:Name="TxtDeviceCode" Text="XXXX-XXXX" FontSize="26" FontWeight="ExtraBold" Foreground="#00D2FF"  />
                        </Border>
                        
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="BtnCopyCode" Content="📋 Скопировать код" Height="36" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" Click="BtnCopyCode_Click" />
                            <Button Grid.Column="2" Content="🌐 Открыть сайт" Height="36" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" Click="BtnOpenMicrosoftLink_Click" />
                        </Grid>
                        
                        <TextBlock x:Name="TxtWaitingMs" Text="⏳ Код скопирован! Вставьте его в браузере..." HorizontalAlignment="Center" Foreground="#F59E0B" FontStyle="Italic" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Button Grid.Row="2" Content="Закрыть" Width="100" Height="34" HorizontalAlignment="Right" Background="#222634" Foreground="#ECEFF4" Click="BtnClose_Click" />
    </Grid>
</Window>

