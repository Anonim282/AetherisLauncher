<Window x:Class="AetherisLauncher.Views.ImportArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Импорт сборки из архива (.zip / .rar)" Height="500" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#12131A" Foreground="#ECEFF4"
        FontFamily="Segoe UI, Inter, Arial"
        ResizeMode="NoResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🗂️ Параметры импортируемой сборки" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12" />

        <!-- Archive Summary -->
        <Border Grid.Row="1" Background="#1A1E2B" BorderBrush="#252A3A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock x:Name="TxtArchiveName" Text="archive.zip" FontWeight="Bold" Foreground="#00D2FF" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TxtArchiveSummary" Text="Анализ архива..." Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Form Fields -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="Название сборки:" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="TxtInstanceName" Height="34" Background="#1B1E29" Foreground="#FFFFFF" BorderBrush="#2A2E3D" Padding="8,6" FontSize="13" Margin="0,0,0,12" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Версия Minecraft:" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbMinecraftVersion" IsEditable="True" Height="34" Background="#1B1E29" Foreground="#12131A" Padding="8,6" FontSize="13">
                        <ComboBoxItem Content="1.21.4" />
                        <ComboBoxItem Content="1.21.1" />
                        <ComboBoxItem Content="1.20.4" />
                        <ComboBoxItem Content="1.20.1" />
                        <ComboBoxItem Content="1.19.2" />
                        <ComboBoxItem Content="1.18.2" />
                        <ComboBoxItem Content="1.16.5" />
                        <ComboBoxItem Content="1.12.2" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Загрузчик модов:" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ComboBox x:Name="CmbModLoader" Height="34" Background="#1B1E29" Foreground="#12131A" Padding="8,6" FontSize="13">
                        <ComboBoxItem Content="neoforge" />
                        <ComboBoxItem Content="forge" />
                        <ComboBoxItem Content="fabric" />
                        <ComboBoxItem Content="vanilla" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Версия загрузчика (необязательно):" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtLoaderVersion" Height="34" Background="#1B1E29" Foreground="#FFFFFF" BorderBrush="#2A2E3D" Padding="8,6" FontSize="13" ToolTip="Например: 47.3.0 для Forge, 0.16.5 для Fabric, 21.1.72 для NeoForge. Оставьте пустым для версии по умолчанию." />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Память (МБ):" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="TxtMemoryMb" Height="34" Background="#1B1E29" Foreground="#FFFFFF" BorderBrush="#2A2E3D" Padding="8,6" FontSize="13" />
                </StackPanel>
            </Grid>

            <TextBlock Text="💡 Подсказка: если версия загрузчика не указана, лаунчер подставит рекомендуемую по умолчанию." Foreground="#8C93A8" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Width="100" Height="38" Background="#252A3A" Foreground="#ECEFF4" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand" Click="BtnCancel_Click" />
            <Button Content="✅ Импортировать" Width="160" Height="38" Background="#00D2FF" Foreground="#0A101D" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnConfirm_Click" />
        </StackPanel>
    </Grid>
</Window>

